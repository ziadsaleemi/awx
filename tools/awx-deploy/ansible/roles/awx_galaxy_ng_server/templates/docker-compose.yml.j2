services:
  redis:
    image: "{{ awx_galaxy_ng_redis_image }}"
    restart: unless-stopped
    networks:
      default:
        aliases:
          - redis
    volumes:
      - "{{ awx_galaxy_ng_data_dir }}/redis:/data:z"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  postgres:
    image: "{{ awx_galaxy_ng_postgres_image }}"
    restart: unless-stopped
    networks:
      default:
        aliases:
          - postgres
    env_file: "{{ awx_galaxy_ng_env_file }}"
    volumes:
      - "{{ awx_galaxy_ng_data_dir }}/postgres:/var/lib/postgresql/data:z"
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "{{ awx_galaxy_ng_postgres_user }}"]
      interval: 10s
      timeout: 5s
      retries: 5

  migrations:
    image: "{{ awx_galaxy_ng_image }}:{{ awx_galaxy_ng_image_tag }}"
    env_file: "{{ awx_galaxy_ng_env_file }}"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    volumes:
      - "{{ awx_galaxy_ng_data_dir }}/pulp:/var/lib/pulp:z"
      - "{{ awx_galaxy_ng_data_dir }}/etc-pulp:/etc/pulp:z"
      - "{{ awx_galaxy_ng_settings_file }}:/etc/pulp/settings.py:ro,z"
      - "{{ awx_galaxy_ng_data_dir }}/tmp-ansible:/tmp/ansible:z"
    command:
      - bash
      - -lc
      - |
        django-admin fix-squashed-migrations
        django-admin migrate
        django-admin shell -c 'import os; from django.contrib.auth import get_user_model; User = get_user_model(); username = os.environ["DJANGO_SUPERUSER_USERNAME"]; User.objects.filter(username=username).exists() or User.objects.create_superuser(username, os.environ.get("DJANGO_SUPERUSER_EMAIL", ""), os.environ["DJANGO_SUPERUSER_PASSWORD"])'

  api:
    image: "{{ awx_galaxy_ng_image }}:{{ awx_galaxy_ng_image_tag }}"
    restart: unless-stopped
    networks:
      default:
        aliases:
          - pulp-api
    env_file: "{{ awx_galaxy_ng_env_file }}"
    environment:
      WAIT_FOR_MIGRATIONS: "1"
      GUNICORN_PORT: "{{ awx_galaxy_ng_api_port }}"
    depends_on:
      migrations:
        condition: service_completed_successfully
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    volumes:
      - "{{ awx_galaxy_ng_data_dir }}/pulp:/var/lib/pulp:z"
      - "{{ awx_galaxy_ng_data_dir }}/etc-pulp:/etc/pulp:z"
      - "{{ awx_galaxy_ng_settings_file }}:/etc/pulp/settings.py:ro,z"
      - "{{ awx_galaxy_ng_data_dir }}/tmp-ansible:/tmp/ansible:z"
    command: ["run", "api"]

  content:
    image: "{{ awx_galaxy_ng_image }}:{{ awx_galaxy_ng_image_tag }}"
    restart: unless-stopped
    networks:
      default:
        aliases:
          - pulp-content
    env_file: "{{ awx_galaxy_ng_env_file }}"
    environment:
      WAIT_FOR_MIGRATIONS: "1"
      GUNICORN_PORT: "{{ awx_galaxy_ng_content_port }}"
    depends_on:
      migrations:
        condition: service_completed_successfully
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    volumes:
      - "{{ awx_galaxy_ng_data_dir }}/pulp:/var/lib/pulp:z"
      - "{{ awx_galaxy_ng_data_dir }}/etc-pulp:/etc/pulp:z"
      - "{{ awx_galaxy_ng_settings_file }}:/etc/pulp/settings.py:ro,z"
      - "{{ awx_galaxy_ng_data_dir }}/tmp-ansible:/tmp/ansible:z"
    command: ["run", "content-app"]

  worker:
    image: "{{ awx_galaxy_ng_image }}:{{ awx_galaxy_ng_image_tag }}"
    restart: unless-stopped
    env_file: "{{ awx_galaxy_ng_env_file }}"
    environment:
      WAIT_FOR_MIGRATIONS: "1"
    depends_on:
      migrations:
        condition: service_completed_successfully
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    volumes:
      - "{{ awx_galaxy_ng_data_dir }}/pulp:/var/lib/pulp:z"
      - "{{ awx_galaxy_ng_data_dir }}/etc-pulp:/etc/pulp:z"
      - "{{ awx_galaxy_ng_settings_file }}:/etc/pulp/settings.py:ro,z"
      - "{{ awx_galaxy_ng_data_dir }}/tmp-ansible:/tmp/ansible:z"
    command: ["run", "worker"]

{% if awx_galaxy_ng_ui_enabled | bool %}
  ui:
    image: "{{ awx_galaxy_ng_ui_image }}:{{ awx_galaxy_ng_ui_image_tag }}"
    restart: unless-stopped
    depends_on:
      - api
      - content
    volumes:
      - "{{ awx_galaxy_ng_ui_conf }}:/opt/app-root/etc/nginx.default.d/galaxy_ng.conf:ro,z"
{% endif %}

  nginx:
    image: "{{ awx_galaxy_ng_nginx_image }}"
    restart: unless-stopped
    depends_on:
      - api
      - content
{% if awx_galaxy_ng_ui_enabled | bool %}
      - ui
{% endif %}
    ports:
      - "{{ awx_galaxy_ng_public_port }}:5001"
    volumes:
      - "{{ awx_galaxy_ng_nginx_conf }}:/etc/nginx/nginx.conf:ro,z"
