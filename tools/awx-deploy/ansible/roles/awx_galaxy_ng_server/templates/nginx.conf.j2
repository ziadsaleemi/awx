worker_processes 1;
events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    types_hash_max_size 4096;

    upstream galaxy_content {
        server content:{{ awx_galaxy_ng_content_port }};
    }

    upstream galaxy_api {
        server api:{{ awx_galaxy_ng_api_port }};
    }

    server {
        listen 5001 default_server;
        server_name _;
        client_max_body_size 0;
        keepalive_timeout 5;

        location = / {
            return 302 {{ awx_galaxy_ng_api_path_prefix | regex_replace('/+$', '') }}/v3/swagger-ui/;
        }

        location = /ui/ {
            return 302 {{ awx_galaxy_ng_api_path_prefix | regex_replace('/+$', '') }}/v3/swagger-ui/;
        }

        location = /ui/login {
            return 302 {{ awx_galaxy_ng_api_path_prefix | regex_replace('/+$', '') }}/v3/swagger-ui/;
        }

        location = /static/galaxy_ng/index.html {
            return 302 {{ awx_galaxy_ng_api_path_prefix | regex_replace('/+$', '') }}/v3/swagger-ui/;
        }

        location {{ awx_galaxy_ng_content_path_prefix }} {
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $http_host;
            proxy_redirect off;
            proxy_pass http://galaxy_content;
        }

        location / {
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $http_host;
            proxy_redirect off;
            proxy_pass http://galaxy_api;
        }
    }
}
