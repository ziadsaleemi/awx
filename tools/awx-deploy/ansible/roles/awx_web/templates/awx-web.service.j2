[Unit]
Description=Capstan Web
After=network-online.target awx-postgres.service awx-redis.service
Wants=network-online.target

[Service]
Restart=always
RestartSec=10
ExecStartPre=-{{ awx_container_engine_cmd }} rm -f awx-web
ExecStart={{ awx_container_engine_cmd }} run --rm --name awx-web --network host --user 1000:0 --hostname {{ inventory_hostname }} {% for host in groups.get('awx_server_nodes', []) | default([]) | unique %}--add-host {{ host }}:{{ hostvars[host].ansible_host | default(host) }} {% endfor %}-e AWX_COMPONENT=web -e AWX_CLUSTER_HOST_ID={{ inventory_hostname }} -v {{ awx_server_config_dir }}/settings.py:/etc/tower/settings.py:ro,z -v {{ awx_server_config_dir }}/SECRET_KEY:/etc/tower/SECRET_KEY:ro,z -v {{ awx_server_config_dir }}/SYSTEM_UUID:/etc/tower/SYSTEM_UUID:ro,z -v {{ awx_server_config_dir }}/nginx.conf:/etc/nginx/nginx.conf:ro,z -v {{ awx_server_config_dir }}/nginx.locations.conf:/etc/nginx/conf.d/nginx.locations.conf:ro,z -v {{ awx_projects_dir }}:/var/lib/awx/projects:z -v {{ awx_media_dir }}:/var/lib/awx/public/media:z -v {{ awx_containers_storage_dir }}:/var/lib/awx/.local/share/containers:z -v {{ awx_receptor_socket_dir }}:/var/run/awx-receptor:z -v {{ awx_nginx_state_dir }}:/var/lib/nginx:z -v {{ awx_rsyslog_dir }}:/var/lib/awx/rsyslog:z {{ awx_image }}:{{ awx_effective_image_tag | default(awx_image_tag) }} /usr/bin/launch_awx_web.sh
ExecStop={{ awx_container_engine_cmd }} stop awx-web
TimeoutStartSec=240

[Install]
WantedBy=multi-user.target
