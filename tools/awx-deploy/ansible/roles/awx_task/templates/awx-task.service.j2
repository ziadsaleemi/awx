[Unit]
Description=AWX Task
After=network-online.target awx-postgres.service awx-redis.service awx-receptor.service
Wants=network-online.target awx-receptor.service

[Service]
Restart=always
RestartSec=10
ExecStartPre=-{{ awx_container_engine_cmd }} rm -f awx-task
ExecStart={{ awx_container_engine_cmd }} run --rm --name awx-task --network host --user 1000:0 --hostname {{ inventory_hostname }} -e AWX_CLUSTER_HOST_ID={{ inventory_hostname }} -v {{ awx_server_config_dir }}/settings.py:/etc/tower/settings.py:ro,Z -v {{ awx_server_config_dir }}/SECRET_KEY:/etc/tower/SECRET_KEY:ro,Z -v {{ awx_server_config_dir }}/SYSTEM_UUID:/etc/tower/SYSTEM_UUID:ro,Z -v {{ awx_server_config_dir }}/receptor.conf:/etc/receptor/receptor.conf:ro,Z -v {{ awx_projects_dir }}:/var/lib/awx/projects:Z -v {{ awx_media_dir }}:/var/lib/awx/public/media:Z -v {{ awx_containers_storage_dir }}:/var/lib/awx/.local/share/containers:Z -v {{ awx_receptor_socket_dir }}:/var/run/awx-receptor:Z -v {{ awx_rsyslog_dir }}:/var/lib/awx/rsyslog:Z {{ awx_image }}:{{ awx_image_tag }} /bin/bash -lc 'wait-for-migrations && awx-manage provision_instance --hostname "$AWX_CLUSTER_HOST_ID" --node_type {{ awx_instance_node_type }} && exec supervisord -c /etc/supervisord_task.conf'
ExecStop={{ awx_container_engine_cmd }} stop awx-task
TimeoutStartSec=240

[Install]
WantedBy=multi-user.target
