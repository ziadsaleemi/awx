[Unit]
Description=AWX PostgreSQL
After=network-online.target
Wants=network-online.target

[Service]
Restart=always
RestartSec=10
EnvironmentFile=/etc/awx/postgres.env
ExecStartPre=-{{ awx_container_engine_cmd }} rm -f awx-postgres
ExecStart={{ awx_container_engine_cmd }} run --rm --name awx-postgres --network host --env-file /etc/awx/postgres.env -v {{ awx_postgres_data_dir }}:/var/lib/pgsql/data:Z {{ awx_postgres_image }}
ExecStop={{ awx_container_engine_cmd }} stop awx-postgres
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
