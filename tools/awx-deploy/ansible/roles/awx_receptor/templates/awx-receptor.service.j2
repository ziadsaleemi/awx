[Unit]
Description=Capstan Receptor
After=network-online.target
Wants=network-online.target

[Service]
Restart=always
RestartSec=10
ExecStartPre=-{{ awx_container_engine_cmd }} rm -f awx-receptor
ExecStart={{ awx_container_engine_cmd }} run --rm --name awx-receptor --network host --hostname {{ inventory_hostname }} {% for host in groups.get('awx_server_nodes', []) | default([]) | unique %}--add-host {{ host }}:{{ hostvars[host].ansible_host | default(host) }} {% endfor %}--user 1000:0 {% if awx_receptor_container_privileged | bool %}--privileged {% endif %}{{ awx_receptor_container_extra_args }} -e AWX_CLUSTER_HOST_ID={{ inventory_hostname }} -v {{ awx_server_config_dir }}/settings.py:/etc/tower/settings.py:ro,z -v {{ awx_server_config_dir }}/SECRET_KEY:/etc/tower/SECRET_KEY:ro,z -v {{ awx_server_config_dir }}/SYSTEM_UUID:/etc/tower/SYSTEM_UUID:ro,z -v {{ awx_server_config_dir }}/receptor.conf:/etc/receptor/receptor.conf:ro,z -v {{ awx_projects_dir }}:/var/lib/awx/projects:z -v {{ awx_media_dir }}:/var/lib/awx/public/media:z -v {{ awx_containers_storage_dir }}:/var/lib/awx/.local/share/containers:z -v {{ awx_receptor_socket_dir }}:/var/run/awx-receptor:z -v {{ awx_rsyslog_dir }}:/var/lib/awx/rsyslog:z {{ awx_image }}:{{ awx_effective_image_tag | default(awx_image_tag) }} receptor --config /etc/receptor/receptor.conf
ExecStop={{ awx_container_engine_cmd }} stop awx-receptor
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
