apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ awx_galaxy_ng_name }}-worker
  namespace: {{ awx_galaxy_ng_namespace }}
spec:
  replicas: {{ awx_galaxy_ng_worker_replicas }}
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ awx_galaxy_ng_name }}-worker
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ awx_galaxy_ng_name }}-worker
    spec:
      initContainers:
        - name: prepare-storage
          image: {{ awx_galaxy_ng_image }}:{{ awx_galaxy_ng_image_tag }}
          command:
            - bash
            - -lc
          args:
            - mkdir -p /var/lib/pulp/tmp /var/lib/pulp/media /var/lib/pulp/artifact /var/lib/pulp/content /tmp/ansible
          volumeMounts:
            - name: pulp
              mountPath: /var/lib/pulp
              subPath: pulp
            - name: tmp-ansible
              mountPath: /tmp/ansible
        - name: write-db-encryption-key
          image: {{ awx_galaxy_ng_image }}:{{ awx_galaxy_ng_image_tag }}
          envFrom:
            - secretRef:
                name: {{ awx_galaxy_ng_name }}-secret
          command:
            - bash
            - -lc
          args:
            - mkdir -p /etc/pulp/certs && printf '%s' "$PULP_DATABASE_FIELDS_SYMMETRIC_KEY" > /etc/pulp/certs/database_fields.symmetric.key && chmod 0600 /etc/pulp/certs/database_fields.symmetric.key
          volumeMounts:
            - name: pulp
              mountPath: /etc/pulp
              subPath: etc-pulp
        - name: wait-migrations
          image: {{ awx_galaxy_ng_image }}:{{ awx_galaxy_ng_image_tag }}
          envFrom:
            - secretRef:
                name: {{ awx_galaxy_ng_name }}-secret
          command: ["wait-for-migrations"]
          volumeMounts:
            - name: pulp
              mountPath: /etc/pulp
              subPath: etc-pulp
            - name: settings
              mountPath: /etc/pulp/settings.py
              subPath: settings.py
              readOnly: true
      containers:
        - name: worker
          image: {{ awx_galaxy_ng_image }}:{{ awx_galaxy_ng_image_tag }}
          args: ["run", "worker"]
          envFrom:
            - secretRef:
                name: {{ awx_galaxy_ng_name }}-secret
          volumeMounts:
            - name: pulp
              mountPath: /var/lib/pulp
              subPath: pulp
            - name: pulp
              mountPath: /etc/pulp
              subPath: etc-pulp
            - name: settings
              mountPath: /etc/pulp/settings.py
              subPath: settings.py
              readOnly: true
            - name: tmp-ansible
              mountPath: /tmp/ansible
      volumes:
        - name: pulp
          persistentVolumeClaim:
            claimName: {{ awx_galaxy_ng_name }}-pulp
        - name: settings
          configMap:
            name: {{ awx_galaxy_ng_name }}-settings
        - name: tmp-ansible
          emptyDir: {}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ awx_galaxy_ng_name }}
  namespace: {{ awx_galaxy_ng_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ awx_galaxy_ng_name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ awx_galaxy_ng_name }}
    spec:
      containers:
        - name: nginx
          image: {{ awx_galaxy_ng_nginx_image }}
          ports:
            - containerPort: 5001
          volumeMounts:
            - name: config
              mountPath: /etc/nginx/nginx.conf
              subPath: nginx.conf
              readOnly: true
      volumes:
        - name: config
          configMap:
            name: {{ awx_galaxy_ng_name }}-nginx
---
