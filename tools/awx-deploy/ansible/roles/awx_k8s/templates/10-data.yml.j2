---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ awx_k8s_name }}-postgres
  namespace: {{ awx_k8s_namespace }}
spec:
  accessModes:
    - ReadWriteOnce
{% if awx_k8s_storage_class | length > 0 %}
  storageClassName: {{ awx_k8s_storage_class }}
{% endif %}
  resources:
    requests:
      storage: {{ awx_k8s_postgres_storage_size }}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ awx_k8s_name }}-projects
  namespace: {{ awx_k8s_namespace }}
spec:
  accessModes:
    - ReadWriteOnce
{% if awx_k8s_storage_class | length > 0 %}
  storageClassName: {{ awx_k8s_storage_class }}
{% endif %}
  resources:
    requests:
      storage: {{ awx_k8s_projects_storage_size }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ awx_k8s_name }}-postgres
  namespace: {{ awx_k8s_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ awx_k8s_name }}-postgres
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ awx_k8s_name }}-postgres
    spec:
      containers:
        - name: postgres
          image: {{ awx_postgres_image }}
          envFrom:
            - secretRef:
                name: {{ awx_k8s_name }}-postgres
          ports:
            - containerPort: 5432
          volumeMounts:
            - name: data
              mountPath: /var/lib/pgsql/data
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: {{ awx_k8s_name }}-postgres
---
apiVersion: v1
kind: Service
metadata:
  name: {{ awx_k8s_name }}-postgres
  namespace: {{ awx_k8s_namespace }}
spec:
  ports:
    - port: 5432
      targetPort: 5432
  selector:
    app.kubernetes.io/name: {{ awx_k8s_name }}-postgres
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ awx_k8s_name }}-redis
  namespace: {{ awx_k8s_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ awx_k8s_name }}-redis
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ awx_k8s_name }}-redis
    spec:
      containers:
        - name: redis
          image: {{ awx_redis_image }}
          command:
            - redis-server
          args:
            - --appendonly
            - "yes"
          ports:
            - containerPort: 6379
---
apiVersion: v1
kind: Service
metadata:
  name: {{ awx_k8s_name }}-redis
  namespace: {{ awx_k8s_namespace }}
spec:
  ports:
    - port: 6379
      targetPort: 6379
  selector:
    app.kubernetes.io/name: {{ awx_k8s_name }}-redis
