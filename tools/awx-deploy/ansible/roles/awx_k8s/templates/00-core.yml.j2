---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ awx_k8s_namespace }}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ awx_k8s_name }}
  namespace: {{ awx_k8s_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: {{ awx_k8s_name }}
  namespace: {{ awx_k8s_namespace }}
rules:
  - apiGroups: [""]
    resources: ["pods", "pods/log", "pods/exec", "services", "configmaps", "secrets", "events", "persistentvolumeclaims"]
    verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
  - apiGroups: ["batch"]
    resources: ["jobs"]
    verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
  - apiGroups: ["apps"]
    resources: ["deployments", "replicasets"]
    verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ awx_k8s_name }}
  namespace: {{ awx_k8s_namespace }}
subjects:
  - kind: ServiceAccount
    name: {{ awx_k8s_name }}
    namespace: {{ awx_k8s_namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: {{ awx_k8s_name }}
{% if awx_gatekeeper_k8s_manage_rbac | bool %}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: {{ awx_k8s_name }}-gatekeeper
rules:
  - apiGroups: ["templates.gatekeeper.sh"]
    resources: ["constrainttemplates"]
    verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
  - apiGroups: ["constraints.gatekeeper.sh"]
    resources: ["*"]
    verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
  - apiGroups: ["config.gatekeeper.sh"]
    resources: ["configs"]
    verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
  - apiGroups: [""]
    resources: ["namespaces"]
    verbs: ["get", "list", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: {{ awx_k8s_name }}-gatekeeper
subjects:
  - kind: ServiceAccount
    name: {{ awx_k8s_name }}
    namespace: {{ awx_k8s_namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: {{ awx_k8s_name }}-gatekeeper
{% endif %}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ awx_k8s_name }}-secret
  namespace: {{ awx_k8s_namespace }}
type: Opaque
stringData:
  SECRET_KEY: {{ awx_k8s_effective_secret_key | quote }}
  ADMIN_PASSWORD: {{ awx_admin_password | quote }}
  settings.py: |
    import json
    import os

    SECRET_KEY = os.environ.get("SECRET_KEY", "")
    if not SECRET_KEY and os.path.exists("/etc/tower/SECRET_KEY"):
        with open("/etc/tower/SECRET_KEY", "r", encoding="utf-8") as secret_key_file:
            SECRET_KEY = secret_key_file.read().strip()

    DATABASES = {
        "default": {
            "ENGINE": "django.db.backends.postgresql",
            "NAME": "{{ awx_postgres_database }}",
            "USER": "{{ awx_postgres_user }}",
            "PASSWORD": "{{ awx_postgres_password }}",
            "HOST": "{{ awx_k8s_name }}-postgres",
            "PORT": "5432",
            "OPTIONS": {},
        }
    }

    ALLOWED_HOSTS = {{ awx_allowed_hosts | to_json }}
    CSRF_TRUSTED_ORIGINS = {{ awx_csrf_trusted_origins | to_json }}
    REMOTE_HOST_HEADERS = {{ awx_remote_host_headers | to_json }}
    PROXY_IP_ALLOWED_LIST = {{ awx_proxy_ip_allowed_list | to_json }}
{% set effective_tower_url_base = awx_tower_url_base %}
{% if not effective_tower_url_base %}
{% if awx_k8s_ingress_enabled and awx_k8s_ingress_host %}
{% set effective_tower_url_base = 'https://' ~ awx_k8s_ingress_host %}
{% elif awx_k8s_service_type == 'NodePort' %}
{% set effective_tower_url_base = 'http://' ~ (ansible_host | default(inventory_hostname)) ~ ':' ~ awx_k8s_node_port %}
{% else %}
{% set effective_tower_url_base = 'http://' ~ awx_k8s_name ~ '-web' %}
{% endif %}
{% endif %}
    TOWER_URL_BASE = {{ effective_tower_url_base | to_json }}
{% set inferred_secure_cookies = effective_tower_url_base.startswith('https://') %}
{% set effective_session_cookie_secure = (awx_session_cookie_secure | bool) if (awx_session_cookie_secure | string | length > 0) else inferred_secure_cookies %}
{% set effective_csrf_cookie_secure = (awx_csrf_cookie_secure | bool) if (awx_csrf_cookie_secure | string | length > 0) else inferred_secure_cookies %}
    SESSION_COOKIE_SECURE = {{ 'True' if effective_session_cookie_secure else 'False' }}
    CSRF_COOKIE_SECURE = {{ 'True' if effective_csrf_cookie_secure else 'False' }}

    CAPSTAN_PRODUCT_MODE = {{ awx_product_mode | to_json }}
    CAPSTAN_SAAS_REGISTRATION_ENABLED = {{ 'True' if awx_saas_registration_enabled | bool else 'False' }}
    CAPSTAN_SAAS_REGISTRATION_RATE_LIMIT = {{ awx_saas_registration_rate_limit | to_json }}
    CAPSTAN_SAAS_REGISTRATION_VERIFICATION_RATE_LIMIT = {{ awx_saas_registration_verification_rate_limit | to_json }}
    CAPSTAN_SAAS_REGISTRATION_TOKEN_MAX_AGE = {{ awx_saas_registration_token_max_age | int }}
    CAPSTAN_SAAS_REGISTRATION_PUBLIC_URL = {{ awx_saas_registration_public_url | to_json }}
    CAPSTAN_SAAS_REGISTRATION_EMAIL_FROM = {{ awx_saas_registration_email_from | to_json }}
    CAPSTAN_SAAS_REGISTRATION_TERMS_VERSION = {{ awx_saas_registration_terms_version | to_json }}
    CAPSTAN_SAAS_REGISTRATION_TERMS_URL = {{ awx_saas_registration_terms_url | to_json }}
    CAPSTAN_SAAS_REGISTRATION_PRIVACY_URL = {{ awx_saas_registration_privacy_url | to_json }}
    CAPSTAN_SAAS_REGISTRATION_BOT_PROVIDER = "turnstile"
    CAPSTAN_SAAS_REGISTRATION_TURNSTILE_SITE_KEY = {{ awx_saas_registration_turnstile_site_key | to_json }}
    CAPSTAN_SAAS_REGISTRATION_TURNSTILE_SECRET_KEY = {{ awx_saas_registration_turnstile_secret_key | to_json }}
    CAPSTAN_SAAS_REQUIRE_EXTERNAL_EXECUTION = {{ 'True' if awx_saas_require_external_execution | bool else 'False' }}

{% if awx_saas_registration_enabled | bool %}
    EMAIL_BACKEND = "django.core.mail.backends.smtp.EmailBackend"
    EMAIL_HOST = {{ awx_saas_smtp_host | to_json }}
    EMAIL_PORT = {{ awx_saas_smtp_port | int }}
    EMAIL_HOST_USER = {{ awx_saas_smtp_user | to_json }}
    EMAIL_HOST_PASSWORD = {{ awx_saas_smtp_password | to_json }}
    EMAIL_USE_TLS = {{ 'True' if awx_saas_smtp_use_tls | bool else 'False' }}
    EMAIL_USE_SSL = {{ 'True' if awx_saas_smtp_use_ssl | bool else 'False' }}
    EMAIL_TIMEOUT = 10
{% endif %}

{% if awx_ldap_enabled | bool %}
    import ldap
    from django_auth_ldap import config as django_auth_ldap_config

    def _capstan_ldap_search(search):
        if not search:
            return None
        base_dn, scope, filter_string = search
        if isinstance(scope, str):
            scope = getattr(ldap, scope)
        return django_auth_ldap_config.LDAPSearch(base_dn, scope, filter_string)

    def _capstan_ldap_option(value):
        if isinstance(value, str) and value.startswith("OPT_"):
            return getattr(ldap, value)
        return value

    AUTH_LDAP_SERVER_URI = {{ awx_ldap_server_uri | to_json }}
    AUTH_LDAP_BIND_DN = {{ awx_ldap_bind_dn | to_json }}
    AUTH_LDAP_BIND_PASSWORD = {{ awx_ldap_bind_password | to_json }}
    AUTH_LDAP_START_TLS = {{ 'True' if awx_ldap_start_tls | bool else 'False' }}
    _capstan_ldap_connection_options = json.loads({{ awx_ldap_connection_options | to_json | to_json }})
    AUTH_LDAP_CONNECTION_OPTIONS = {
        _capstan_ldap_option(key): _capstan_ldap_option(value)
        for key, value in _capstan_ldap_connection_options.items()
    }
    _capstan_ldap_user_search = json.loads({{ awx_ldap_user_search | to_json | to_json }})
    if _capstan_ldap_user_search and isinstance(_capstan_ldap_user_search[0], list):
        AUTH_LDAP_USER_SEARCH = django_auth_ldap_config.LDAPSearchUnion(
            *[_capstan_ldap_search(search) for search in _capstan_ldap_user_search]
        )
    else:
        AUTH_LDAP_USER_SEARCH = _capstan_ldap_search(_capstan_ldap_user_search)
    AUTH_LDAP_USER_DN_TEMPLATE = {{ (awx_ldap_user_dn_template | to_json) if awx_ldap_user_dn_template is not none else 'None' }}
    AUTH_LDAP_USER_ATTR_MAP = json.loads({{ awx_ldap_user_attr_map | to_json | to_json }})
    AUTH_LDAP_GROUP_SEARCH = _capstan_ldap_search(json.loads({{ awx_ldap_group_search | to_json | to_json }}))
    AUTH_LDAP_GROUP_TYPE_PARAMS = json.loads({{ awx_ldap_group_type_params | to_json | to_json }})
    AUTH_LDAP_GROUP_TYPE = getattr(django_auth_ldap_config, {{ awx_ldap_group_type | to_json }})(**AUTH_LDAP_GROUP_TYPE_PARAMS)
    AUTH_LDAP_REQUIRE_GROUP = {{ (awx_ldap_require_group | to_json) if awx_ldap_require_group is not none else 'None' }}
    AUTH_LDAP_DENY_GROUP = {{ (awx_ldap_deny_group | to_json) if awx_ldap_deny_group is not none else 'None' }}
    AUTH_LDAP_USER_FLAGS_BY_GROUP = json.loads({{ awx_ldap_user_flags_by_group | to_json | to_json }})
    AUTH_LDAP_ORGANIZATION_MAP = json.loads({{ awx_ldap_organization_map | to_json | to_json }})
    AUTH_LDAP_TEAM_MAP = json.loads({{ awx_ldap_team_map | to_json | to_json }})
{% endif %}

{% if awx_entra_enabled | bool %}
    SOCIAL_AUTH_AZUREAD_TENANT_OAUTH2_KEY = {{ awx_entra_client_id | to_json }}
    SOCIAL_AUTH_AZUREAD_TENANT_OAUTH2_SECRET = {{ awx_entra_client_secret | to_json }}
    SOCIAL_AUTH_AZUREAD_TENANT_OAUTH2_TENANT_ID = {{ awx_entra_tenant_id | to_json }}
    SOCIAL_AUTH_AZUREAD_TENANT_OAUTH2_AUTHORITY_HOST = {{ awx_entra_authority_host | to_json }}
    SOCIAL_AUTH_AZUREAD_TENANT_OAUTH2_ORGANIZATION_MAP = json.loads({{ awx_entra_organization_map | to_json | to_json }})
    SOCIAL_AUTH_AZUREAD_TENANT_OAUTH2_TEAM_MAP = json.loads({{ awx_entra_team_map | to_json | to_json }})
{% endif %}

    BROKER_URL = "redis://{{ awx_k8s_name }}-redis:6379/0"
    CACHES = {
        "default": {
            "BACKEND": "awx.main.cache.AWXRedisCache",
            "LOCATION": "redis://{{ awx_k8s_name }}-redis:6379/1",
        }
    }
    CHANNEL_LAYERS = {
        "default": {
            "BACKEND": "channels_redis.core.RedisChannelLayer",
            "CONFIG": {"hosts": [BROKER_URL], "capacity": 10000, "group_expiry": 157784760},
        }
    }

    CLUSTER_HOST_ID = os.environ.get("AWX_CLUSTER_HOST_ID", os.uname().nodename)
    SYSTEM_UUID = os.environ.get("AWX_SYSTEM_UUID", "")
    IS_K8S = True
    AWX_AUTO_DEPROVISION_INSTANCES = True
    AWX_CONTAINER_GROUP_DEFAULT_NAMESPACE = os.environ.get("MY_POD_NAMESPACE", "{{ awx_k8s_namespace }}")
    BROADCAST_WEBSOCKET_PORT = 80
    BROADCAST_WEBSOCKET_PROTOCOL = "http"
    BROADCAST_WEBSOCKET_VERIFY_CERT = False
    STATIC_ROOT = "/var/lib/awx/public/static"
    MEDIA_ROOT = "/var/lib/awx/public/media"
    PROJECTS_ROOT = "/var/lib/awx/projects"
    GLOBAL_JOB_EXECUTION_ENVIRONMENTS = [{"name": "Capstan EE (latest)", "image": "{{ awx_ee_image }}"}]
    CONTROL_PLANE_EXECUTION_ENVIRONMENT = "{{ awx_control_plane_ee_image }}"
{% if awx_eda_configure_awx_settings | bool %}
{% set effective_eda_server_url = awx_eda_server_url if awx_eda_server_url else awx_eda_k8s_api_url %}
    EDA_SERVER_URL = {{ effective_eda_server_url | to_json }}
    EDA_USERNAME = {{ awx_eda_username | to_json }}
    EDA_PASSWORD = {{ awx_eda_password | to_json }}
    EDA_VERIFY_SSL = {{ 'True' if awx_eda_verify_ssl | bool else 'False' }}
    EDA_REQUEST_TIMEOUT = {{ awx_eda_request_timeout | int }}
{% endif %}
{% if awx_galaxy_ng_configure_awx_settings | bool %}
{% set effective_galaxy_ng_server_url = awx_galaxy_ng_server_url if awx_galaxy_ng_server_url else awx_galaxy_ng_k8s_url %}
    GALAXY_NG_SERVER_URL = {{ effective_galaxy_ng_server_url | to_json }}
    GALAXY_NG_AUTH_TOKEN = {{ awx_galaxy_ng_auth_token | to_json }}
    GALAXY_NG_USERNAME = {{ awx_galaxy_ng_username | to_json }}
    GALAXY_NG_PASSWORD = {{ awx_galaxy_ng_password | to_json }}
    GALAXY_NG_VERIFY_SSL = {{ 'True' if awx_galaxy_ng_verify_ssl | bool else 'False' }}
    GALAXY_NG_REQUEST_TIMEOUT = {{ awx_galaxy_ng_request_timeout | int }}
    GALAXY_NG_API_PATH_PREFIX = {{ awx_galaxy_ng_api_path_prefix | to_json }}
    GALAXY_NG_CONTENT_PATH_PREFIX = {{ awx_galaxy_ng_content_path_prefix | to_json }}
{% endif %}
{% if awx_quay_configure_awx_settings | bool %}
{% set effective_quay_registry_url = awx_quay_registry_url if awx_quay_registry_url else awx_quay_k8s_url %}
    QUAY_REGISTRY_URL = {{ effective_quay_registry_url | to_json }}
    QUAY_NAMESPACE = {{ awx_quay_namespace | to_json }}
    QUAY_API_TOKEN = {{ (awx_quay_effective_api_token | default(awx_quay_api_token)) | to_json }}
    QUAY_PUSH_USERNAME = {{ (awx_quay_effective_push_username | default(awx_quay_push_username)) | to_json }}
    QUAY_PUSH_TOKEN = {{ (awx_quay_effective_push_token | default(awx_quay_push_token)) | to_json }}
    QUAY_VERIFY_SSL = {{ 'True' if awx_quay_verify_ssl | bool else 'False' }}
    QUAY_REQUEST_TIMEOUT = {{ awx_quay_request_timeout | int }}
{% endif %}
{% if awx_opa_configure_awx_settings | bool %}
{% set effective_opa_host = awx_opa_host %}
{% if not effective_opa_host %}
{% set effective_opa_host = awx_opa_k8s_host %}
{% endif %}
{% if not effective_opa_host and awx_opa_server_inventory_host %}
{% set opa_host = hostvars.get(awx_opa_server_inventory_host, {}).get('ansible_host', awx_opa_server_inventory_host) %}
{% set effective_opa_host = opa_host %}
{% endif %}
    OPA_HOST = {{ effective_opa_host | to_json }}
    OPA_PORT = {{ awx_opa_port | int }}
    OPA_SSL = {{ 'True' if awx_opa_ssl | bool else 'False' }}
    OPA_AUTH_TYPE = {{ awx_opa_auth_type | to_json }}
    OPA_AUTH_TOKEN = {{ awx_opa_auth_token | to_json }}
    OPA_AUTH_CLIENT_CERT = {{ awx_opa_auth_client_cert | to_json }}
    OPA_AUTH_CLIENT_KEY = {{ awx_opa_auth_client_key | to_json }}
    OPA_AUTH_CA_CERT = {{ awx_opa_auth_ca_cert | to_json }}
    OPA_AUTH_CUSTOM_HEADERS = {{ awx_opa_auth_custom_headers | to_json }}
    OPA_REQUEST_TIMEOUT = {{ awx_opa_request_timeout | float }}
    OPA_REQUEST_RETRIES = {{ awx_opa_request_retries | int }}
    OPA_POLICY_BUNDLE = {{ awx_opa_policy_bundle | to_json }}
{% endif %}
{% if awx_gatekeeper_configure_awx_settings | bool %}
    GATEKEEPER_K8S_API_URL = {{ awx_gatekeeper_k8s_api_url | to_json }}
    GATEKEEPER_K8S_AUTH_TOKEN = {{ awx_gatekeeper_k8s_auth_token | to_json }}
{% if awx_gatekeeper_k8s_use_service_account_token | bool %}
    if not GATEKEEPER_K8S_AUTH_TOKEN and os.path.exists("/var/run/secrets/kubernetes.io/serviceaccount/token"):
        with open("/var/run/secrets/kubernetes.io/serviceaccount/token", "r", encoding="utf-8") as gatekeeper_token_file:
            GATEKEEPER_K8S_AUTH_TOKEN = gatekeeper_token_file.read().strip()
{% endif %}
    GATEKEEPER_K8S_CONTEXT = {{ awx_gatekeeper_k8s_context | to_json }}
    GATEKEEPER_K8S_CONTEXTS = {{ (awx_gatekeeper_k8s_contexts | to_json) | to_json }}
    GATEKEEPER_K8S_VERIFY_SSL = {{ 'True' if awx_gatekeeper_k8s_verify_ssl | bool else 'False' }}
    GATEKEEPER_K8S_REQUEST_TIMEOUT = {{ awx_gatekeeper_k8s_request_timeout | int }}
{% endif %}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ awx_k8s_name }}-postgres
  namespace: {{ awx_k8s_namespace }}
type: Opaque
stringData:
  POSTGRESQL_USER: {{ awx_postgres_user | quote }}
  POSTGRESQL_DATABASE: {{ awx_postgres_database | quote }}
  POSTGRESQL_PASSWORD: {{ awx_postgres_password | quote }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ awx_k8s_name }}-nginx
  namespace: {{ awx_k8s_namespace }}
data:
  nginx.conf: |
    worker_processes 1;
    error_log /var/lib/nginx/error.log warn;
    pid /var/lib/nginx/nginx.pid;
    events { worker_connections 1024; }
    http {
      include /etc/nginx/mime.types;
      default_type application/octet-stream;
      server_tokens off;
      access_log /var/lib/nginx/access.log;
      map $http_upgrade $connection_upgrade { default upgrade; '' close; }
      upstream uwsgi { server 127.0.0.1:8050; }
      upstream daphne { server 127.0.0.1:8051; }
      server {
        listen 8013 default_server;
        server_name _;
        include /etc/nginx/conf.d/*.conf;
      }
    }
  nginx.locations.conf: |
    location /static { alias /var/lib/awx/public/static/; }
    location /locales { alias /var/lib/awx/public/static/awx/locales; }
    location /assets { alias /var/lib/awx/public/static/awx/assets; }
    location ~ ^/[^/]+\.(css|js|map|txt|woff|woff2|ttf|eot)$ {
      root /var/lib/awx/public/static/awx;
      try_files $uri =404;
      gzip_static on;
    }
    location ~ ^(/websocket/|/api/websocket/) {
      proxy_pass http://daphne;
      proxy_http_version 1.1;
      proxy_buffering off;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header Host $http_host;
      proxy_redirect off;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
    }
    location / {
      uwsgi_read_timeout 120s;
      uwsgi_pass uwsgi;
      include /etc/nginx/uwsgi_params;
    }
  receptor.conf: |
    ---
    - local-only:
    - log-level: {{ awx_receptor_log_level }}
    - node:
        id: __HOSTNAME__
        firewallrules:
          - action: reject
            tonode: __HOSTNAME__
            toservice: control
    - control-service:
        service: control
        filename: /var/run/receptor/receptor.sock
        permissions: "0660"
{% if awx_product_mode == 'on_prem' %}
    - work-command:
        worktype: {{ awx_receptor_work_type }}
        command: {{ awx_receptor_runner_command }}
        params: worker
        allowruntimeparams: true
        verifysignature: false
{% endif %}
    - work-signing:
        privatekey: /etc/receptor/work_private_key.pem
        tokenexpiration: 1m
    - work-verification:
        publickey: /etc/receptor/work_public_key.pem
{% if awx_product_mode == 'on_prem' %}
    - work-kubernetes:
        worktype: kubernetes-runtime-auth
        authmethod: runtime
        allowruntimeauth: true
        allowruntimepod: true
        allowruntimeparams: true
        verifysignature: false
    - work-kubernetes:
        worktype: kubernetes-incluster-auth
        authmethod: incluster
        allowruntimeauth: true
        allowruntimepod: true
        allowruntimeparams: true
        verifysignature: false
{% endif %}
    - tls-client:
        name: tlsclient
        rootcas: /etc/receptor/tls/ca/mesh-CA.crt
        cert: /etc/receptor/tls/receptor.crt
        key: /etc/receptor/tls/receptor.key
        mintls13: false
