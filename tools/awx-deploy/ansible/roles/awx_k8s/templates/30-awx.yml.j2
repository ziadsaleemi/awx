---
apiVersion: v1
kind: Service
metadata:
  name: {{ awx_k8s_name }}-web
  namespace: {{ awx_k8s_namespace }}
spec:
  type: {{ awx_k8s_service_type }}
  ports:
    - name: http
      port: 80
      targetPort: 8013
{% if awx_k8s_service_type == 'NodePort' and (awx_k8s_node_port | int) > 0 %}
      nodePort: {{ awx_k8s_node_port }}
{% endif %}
  selector:
    app.kubernetes.io/name: {{ awx_k8s_name }}-web
{% if awx_k8s_ingress_enabled | bool %}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ awx_k8s_name }}
  namespace: {{ awx_k8s_namespace }}
spec:
  rules:
    - host: {{ awx_k8s_ingress_host }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ awx_k8s_name }}-web
                port:
                  number: 80
{% endif %}
