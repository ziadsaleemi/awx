---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ awx_k8s_name }}-web
  namespace: {{ awx_k8s_namespace }}
spec:
  replicas: {{ awx_k8s_web_replicas }}
  revisionHistoryLimit: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ awx_k8s_name }}-web
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ awx_k8s_name }}-web
    spec:
      serviceAccountName: {{ awx_k8s_name }}
      securityContext:
        runAsUser: 1000
        runAsGroup: 0
        fsGroup: 0
      initContainers:
        - name: init-receptor-config
          image: {{ awx_image }}:{{ awx_image_tag }}
          command:
            - /bin/bash
            - -lc
          args:
            - |
              cp /receptor-template/receptor.conf /etc/receptor/receptor.conf
              mkdir -p /etc/receptor/tls/ca
              cp /receptor-secret/mesh-CA.crt /etc/receptor/tls/ca/mesh-CA.crt
              cp /receptor-secret/mesh-CA.key /etc/receptor/tls/ca/mesh-CA.key
              openssl req -newkey rsa:2048 -nodes \
                -keyout /etc/receptor/tls/receptor.key \
                -subj "/CN=${HOSTNAME}" \
                -addext "subjectAltName=DNS:${HOSTNAME},otherName:1.3.6.1.4.1.2312.19.1;UTF8:${HOSTNAME}" \
                -out /tmp/receptor.csr
              openssl x509 -req \
                -in /tmp/receptor.csr \
                -CA /etc/receptor/tls/ca/mesh-CA.crt \
                -CAkey /etc/receptor/tls/ca/mesh-CA.key \
                -CAcreateserial \
                -out /etc/receptor/tls/receptor.crt \
                -days 3650 -sha256 \
                -copy_extensions copy
              cp /receptor-secret/work_private_key.pem /etc/receptor/work_private_key.pem
              cp /receptor-secret/work_public_key.pem /etc/receptor/work_public_key.pem
              chgrp 0 /etc/receptor /etc/receptor/receptor.conf
              chgrp -R 0 /etc/receptor/tls /etc/receptor/work_private_key.pem /etc/receptor/work_public_key.pem
              chmod 0775 /etc/receptor
              chmod 0664 /etc/receptor/receptor.conf
              chmod 0755 /etc/receptor/tls /etc/receptor/tls/ca
              chmod 0640 /etc/receptor/tls/ca/mesh-CA.key /etc/receptor/tls/receptor.key /etc/receptor/work_private_key.pem
              chmod 0644 /etc/receptor/tls/ca/mesh-CA.crt /etc/receptor/tls/receptor.crt /etc/receptor/work_public_key.pem
          volumeMounts:
            - name: awx-nginx
              mountPath: /receptor-template/receptor.conf
              subPath: receptor.conf
              readOnly: true
            - name: awx-receptor
              mountPath: /receptor-secret
              readOnly: true
            - name: receptor-config
              mountPath: /etc/receptor
        - name: init-nginx-state
          image: {{ awx_image }}:{{ awx_image_tag }}
          command:
            - /bin/bash
            - -lc
          args:
            - mkdir -p /var/lib/nginx/tmp/client_body /var/lib/nginx/tmp/proxy /var/lib/nginx/tmp/fastcgi /var/lib/nginx/tmp/uwsgi /var/lib/nginx/tmp/scgi
          volumeMounts:
            - name: nginx-state
              mountPath: /var/lib/nginx
      containers:
        - name: awx-web
          image: {{ awx_image }}:{{ awx_image_tag }}
          command:
            - /usr/bin/launch_awx_web.sh
          env:
            - name: AWX_CLUSTER_HOST_ID
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: AWX_SYSTEM_UUID
              valueFrom:
                fieldRef:
                  fieldPath: metadata.uid
            - name: MY_POD_IP
              value: {{ awx_k8s_name }}-web.{{ awx_k8s_namespace }}.svc.cluster.local
          ports:
            - containerPort: 8013
          volumeMounts:
            - name: awx-secret
              mountPath: /etc/tower/settings.py
              subPath: settings.py
              readOnly: true
            - name: awx-secret
              mountPath: /etc/tower/SECRET_KEY
              subPath: SECRET_KEY
              readOnly: true
            - name: awx-nginx
              mountPath: /etc/nginx/nginx.conf
              subPath: nginx.conf
              readOnly: true
            - name: awx-nginx
              mountPath: /etc/nginx/conf.d/nginx.locations.conf
              subPath: nginx.locations.conf
              readOnly: true
            - name: receptor-config
              mountPath: /etc/receptor
            - name: projects
              mountPath: /var/lib/awx/projects
              subPath: projects
            - name: projects
              mountPath: /var/lib/awx/public/media
              subPath: media
            - name: containers
              mountPath: /var/lib/awx/.local/share/containers
            - name: receptor
              mountPath: /var/run/receptor
            - name: nginx-state
              mountPath: /var/lib/nginx
        - name: receptor
          image: {{ awx_image }}:{{ awx_image_tag }}
          command:
            - /bin/bash
            - -lc
          args:
            - sed -i "s/__HOSTNAME__/${HOSTNAME}/g" /etc/receptor/receptor.conf && exec receptor --config /etc/receptor/receptor.conf
          volumeMounts:
            - name: receptor-config
              mountPath: /etc/receptor
            - name: projects
              mountPath: /var/lib/awx/projects
              subPath: projects
            - name: projects
              mountPath: /var/lib/awx/public/media
              subPath: media
            - name: containers
              mountPath: /var/lib/awx/.local/share/containers
            - name: receptor
              mountPath: /var/run/receptor
      volumes:
        - name: awx-secret
          secret:
            secretName: {{ awx_k8s_name }}-secret
        - name: awx-nginx
          configMap:
            name: {{ awx_k8s_name }}-nginx
        - name: awx-receptor
          secret:
            secretName: {{ awx_k8s_name }}-receptor
        - name: projects
          persistentVolumeClaim:
            claimName: {{ awx_k8s_name }}-projects
        - name: containers
          emptyDir: {}
        - name: receptor
          emptyDir: {}
        - name: receptor-config
          emptyDir: {}
        - name: nginx-state
          emptyDir: {}
---
