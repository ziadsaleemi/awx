---
apiVersion: batch/v1
kind: Job
metadata:
  name: {{ awx_k8s_name }}-migrate
  namespace: {{ awx_k8s_namespace }}
spec:
  backoffLimit: 2
  template:
    spec:
      serviceAccountName: {{ awx_k8s_name }}
      restartPolicy: OnFailure
      securityContext:
        runAsUser: 1000
        runAsGroup: 0
        fsGroup: 0
      containers:
        - name: migrate
          image: {{ awx_image }}:{{ awx_image_tag }}
          command:
            - /bin/bash
            - -lc
          args:
            - |
              awx-manage migrate --noinput
              awx-manage shell -c "import os; from django.contrib.auth import get_user_model; User=get_user_model(); user,_=User.objects.get_or_create(username='{{ awx_admin_user }}', defaults={'email':'admin@localhost','is_superuser':True,'is_staff':True,'is_active':True}); desired={'email':'admin@localhost','is_superuser':True,'is_staff':True,'is_active':True}; [setattr(user,k,v) for k,v in desired.items() if getattr(user,k)!=v]; password=os.environ.get('DJANGO_SUPERUSER_PASSWORD'); password and user.set_password(password); user.save(); print('Admin synchronized')"
          env:
            - name: DJANGO_SUPERUSER_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ awx_k8s_name }}-secret
                  key: ADMIN_PASSWORD
            - name: AWX_CLUSTER_HOST_ID
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: AWX_SYSTEM_UUID
              valueFrom:
                fieldRef:
                  fieldPath: metadata.uid
          volumeMounts:
            - name: awx-secret
              mountPath: /etc/tower/settings.py
              subPath: settings.py
              readOnly: true
            - name: awx-secret
              mountPath: /etc/tower/SECRET_KEY
              subPath: SECRET_KEY
              readOnly: true
      volumes:
        - name: awx-secret
          secret:
            secretName: {{ awx_k8s_name }}-secret
