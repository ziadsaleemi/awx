SERVER_HOSTNAME: {{ awx_quay_effective_server_hostname | quote }}
PREFERRED_URL_SCHEME: {{ awx_quay_preferred_url_scheme | quote }}
REGISTRY_TITLE: {{ awx_quay_registry_title | quote }}
SETUP_COMPLETE: true
SUPER_USERS:
  - {{ awx_quay_admin_user | quote }}
FEATURE_USER_CREATION: true
FEATURE_USER_INITIALIZE: true
FEATURE_DIRECT_LOGIN: true
BROWSER_API_CALLS_XHR_ONLY: false
FEATURE_MAILING: false
FEATURE_PROXY_STORAGE: false
FEATURE_REPO_MIRROR: false
FEATURE_BUILD_SUPPORT: false
AUTHENTICATION_TYPE: Database
SECRET_KEY: {{ awx_quay_secret_key | quote }}
DATABASE_SECRET_KEY: {{ awx_quay_database_secret_key | quote }}
DB_URI: {{ ('postgresql://' ~ (awx_quay_postgres_user | urlencode | replace('/', '%2F')) ~ ':' ~ (awx_quay_postgres_password | urlencode | replace('/', '%2F')) ~ '@postgres:5432/' ~ (awx_quay_postgres_database | urlencode | replace('/', '%2F'))) | quote }}
BUILDLOGS_REDIS:
  host: redis
  port: 6379
  ssl: false
USER_EVENTS_REDIS:
  host: redis
  port: 6379
  ssl: false
DISTRIBUTED_STORAGE_CONFIG:
  default:
    - LocalStorage
    - storage_path: /datastorage/registry
DISTRIBUTED_STORAGE_DEFAULT_LOCATIONS: []
DISTRIBUTED_STORAGE_PREFERENCE:
  - default
USERFILES_LOCATION: default
DEFAULT_TAG_EXPIRATION: 2w
CREATE_PRIVATE_REPO_ON_PUSH: true
ALLOW_PULLS_WITHOUT_STRICT_LOGGING: true
LOGS_MODEL: database
