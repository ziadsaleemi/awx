---
# Copy to group_vars/all.yml or pass as extra vars. Do not commit secrets.

awx_deploy_method: server # server | k3s | k8s

awx_image: docker.io/ziadsaleemi/awx
awx_image_tag: "25.1.3"
awx_ee_image: quay.io/ansible/awx-ee:latest

awx_admin_user: admin
awx_admin_password: "{{ lookup('env', 'AWX_ADMIN_PASSWORD') }}"

awx_container_engine: podman # podman | docker
awx_server_base_dir: /opt/awx
awx_server_config_dir: /etc/awx
awx_server_data_dir: /var/lib/awx
awx_server_backup_dir: /var/backups/awx
awx_server_http_port: 8080
awx_server_https_port: 8443
awx_server_root_owner: root
awx_server_root_group: root
awx_server_runtime_owner: "1000"
awx_server_runtime_group: "0"

awx_hostname: "{{ groups['awx_lb'] | default([]) | first | default(groups['awx_web'] | first | default(inventory_hostname)) }}"
awx_allowed_hosts:
  - "*"
awx_csrf_trusted_origins: []
awx_proxy_ip_allowed_list: []

awx_postgres_host: "{{ groups['awx_database'] | first | default('127.0.0.1') }}"
awx_postgres_port: 5432
awx_postgres_database: awx
awx_postgres_user: awx
awx_postgres_password: "{{ lookup('env', 'AWX_POSTGRES_PASSWORD') }}"
awx_postgres_image: quay.io/sclorg/postgresql-15-c9s

awx_redis_host: "{{ groups['awx_redis'] | first | default('127.0.0.1') }}"
awx_redis_port: 6379
awx_redis_image: docker.io/library/redis:7.4

awx_receptor_listen_port: 2222
awx_receptor_peer_hosts: "{{ groups.get('awx_receptor', []) | difference([inventory_hostname]) }}"
awx_receptor_container_privileged: true
awx_instance_node_type: hybrid

awx_lb_http_port: 80
awx_lb_extra_http_ports: []
awx_lb_https_port: 443
awx_lb_stats_port: 1936

awx_k8s_namespace: awx
awx_k8s_name: awx
awx_k8s_storage_class: ""
awx_k8s_postgres_storage_size: 20Gi
awx_k8s_projects_storage_size: 10Gi
awx_k8s_web_replicas: 2
awx_k8s_task_replicas: 2
awx_k8s_service_type: ClusterIP
awx_k8s_node_port: 30813
awx_k8s_ingress_enabled: false
awx_k8s_ingress_host: ""
awx_k8s_kubectl_binary: kubectl
awx_k8s_kubeconfig: "{{ lookup('env', 'KUBECONFIG') }}"

awx_k3s_install_url: https://get.k3s.io
awx_k3s_channel: stable
awx_k3s_write_kubeconfig_mode: "0644"
awx_k3s_disable:
  - traefik
  - network-policy

awx_backup_name: "awx-{{ ansible_date_time.iso8601_basic_short }}"
awx_restore_confirm: false
awx_restore_path: ""

# Event-Driven Ansible deployment integration.
# For k3s/k8s, enabling this deploys EDA in Kubernetes beside AWX and configures
# AWX to talk to the in-cluster EDA service.
# For server deployments, deploy EDA on hosts in [awx_eda], then set
# awx_eda_configure_awx_settings=true so AWX points to that EDA VM.
awx_eda_enabled: false
awx_eda_configure_awx_settings: "{{ awx_eda_enabled }}"
awx_eda_namespace: eda
awx_eda_name: awx-eda
awx_eda_admin_user: admin
awx_eda_admin_password: "{{ lookup('env', 'EDA_ADMIN_PASSWORD') | default(awx_admin_password, true) }}"
awx_eda_server_url: ""
awx_eda_verify_ssl: false

# Server/VM EDA path.
awx_eda_server_repo_url: https://github.com/ansible/eda-server.git
awx_eda_server_repo_version: main
awx_eda_server_api_port: 8000
awx_eda_server_ui_port: 8443

# k3s/k8s EDA path.
awx_eda_k8s_operator_ref: main
awx_eda_k8s_service_type: ClusterIP
awx_eda_k8s_node_port: 30855
