---
# Copy to group_vars/all.yml or pass as extra vars. Do not commit secrets.

awx_deploy_method: server # server | k3s | k8s

awx_image: docker.io/ziadsaleemi/awx
awx_image_tag: "25.1.6"
awx_ee_image: quay.io/ansible/awx-ee:latest

awx_admin_user: admin
awx_admin_password: "{{ lookup('env', 'AWX_ADMIN_PASSWORD') }}"

awx_container_engine: podman # podman | docker
awx_server_base_dir: /opt/awx
awx_server_config_dir: /etc/awx
awx_server_data_dir: /var/lib/awx
awx_server_backup_dir: /var/backups/awx
awx_server_http_port: 8080
awx_server_https_port: 8443
awx_server_root_owner: root
awx_server_root_group: root
awx_server_runtime_owner: "1000"
awx_server_runtime_group: "0"

awx_hostname: "{{ groups['awx_lb'] | default([]) | first | default(groups['awx_web'] | first | default(inventory_hostname)) }}"
awx_allowed_hosts:
  - "*"
awx_csrf_trusted_origins: []
awx_proxy_ip_allowed_list: []

awx_postgres_host: "{{ groups['awx_database'] | first | default('127.0.0.1') }}"
awx_postgres_port: 5432
awx_postgres_database: awx
awx_postgres_user: awx
awx_postgres_password: "{{ lookup('env', 'AWX_POSTGRES_PASSWORD') }}"
awx_postgres_image: quay.io/sclorg/postgresql-15-c9s

awx_redis_host: "{{ groups['awx_redis'] | first | default('127.0.0.1') }}"
awx_redis_port: 6379
awx_redis_image: docker.io/library/redis:7.4

awx_receptor_listen_port: 2222
awx_receptor_peer_hosts: "{{ groups.get('awx_receptor', []) | difference([inventory_hostname]) }}"
awx_receptor_container_privileged: true
awx_instance_node_type: hybrid

awx_lb_http_port: 80
awx_lb_extra_http_ports: []
awx_lb_https_port: 443
awx_lb_stats_port: 1936

awx_k8s_namespace: awx
awx_k8s_name: awx
awx_k8s_storage_class: ""
awx_k8s_postgres_storage_size: 20Gi
awx_k8s_projects_storage_size: 10Gi
awx_k8s_web_replicas: 2
awx_k8s_task_replicas: 2
awx_k8s_service_type: ClusterIP
awx_k8s_node_port: 30813
awx_k8s_ingress_enabled: false
awx_k8s_ingress_host: ""
awx_k8s_kubectl_binary: kubectl
awx_k8s_kubeconfig: "{{ lookup('env', 'KUBECONFIG') }}"
awx_k8s_manage_firewalld: true
awx_k8s_firewalld_trusted_interfaces:
  - cni0
  - flannel.1
awx_k8s_firewalld_kubelet_metrics_port: 10250

awx_k3s_install_url: https://get.k3s.io
awx_k3s_channel: stable
awx_k3s_write_kubeconfig_mode: "0644"
awx_k3s_disable:
  - traefik
  - network-policy
awx_k3s_integrated_capacity_check_enabled: true
awx_k3s_min_memory_mb_for_integrated_services: 16384
awx_k3s_min_vcpus_for_integrated_services: 4

awx_backup_name: "awx-{{ ansible_date_time.iso8601_basic_short }}"
awx_restore_confirm: false
awx_restore_path: ""
awx_k8s_backup_dir: "{{ awx_server_backup_dir }}"
awx_k8s_backup_collect_projects: true
awx_k8s_restore_start_after_restore: true
awx_k8s_restore_data: true

# Event-Driven Ansible deployment integration.
# For k3s/k8s, enabling this deploys EDA in Kubernetes beside AWX and configures
# AWX to talk to the in-cluster EDA service.
# For server deployments, deploy EDA on hosts in [awx_eda], then set
# awx_eda_configure_awx_settings=true so AWX points to that EDA VM.
awx_eda_enabled: false
awx_eda_configure_awx_settings: "{{ awx_eda_enabled }}"
awx_eda_namespace: eda
awx_eda_name: awx-eda
awx_eda_admin_user: admin
awx_eda_admin_password: "{{ lookup('env', 'EDA_ADMIN_PASSWORD') | default(awx_admin_password, true) }}"
awx_eda_server_url: ""
awx_eda_verify_ssl: false

# Server/VM EDA path.
awx_eda_server_repo_url: https://github.com/ansible/eda-server.git
awx_eda_server_repo_version: main
awx_eda_server_api_port: 8000
awx_eda_server_ui_port: 8443

# k3s/k8s EDA path.
awx_eda_k8s_operator_ref: "1.0.2"
awx_eda_k8s_operator_image_tag: "1.0.2"
awx_eda_k8s_kube_rbac_proxy_image: quay.io/brancz/kube-rbac-proxy
awx_eda_k8s_kube_rbac_proxy_image_tag: v0.15.0
awx_eda_k8s_service_type: ClusterIP
awx_eda_k8s_node_port: 30855
awx_eda_k8s_api_service_name: "{{ awx_eda_name }}-api"
awx_eda_k8s_api_service_port: 8000
awx_eda_k8s_api_url: "http://{{ awx_eda_k8s_api_service_name }}.{{ awx_eda_namespace }}.svc.cluster.local:{{ awx_eda_k8s_api_service_port }}"

# Galaxy NG / private automation hub deployment integration.
# For k3s/k8s, enabling this deploys Galaxy NG beside AWX and configures AWX to
# talk to the in-cluster hub service. For server deployments, deploy Galaxy NG
# on hosts in [awx_galaxy_ng], then set awx_galaxy_ng_configure_awx_settings=true.
awx_galaxy_ng_enabled: false
awx_galaxy_ng_configure_awx_settings: "{{ awx_galaxy_ng_enabled }}"
awx_galaxy_ng_image: quay.io/ansible/galaxy-ng
awx_galaxy_ng_image_tag: latest
awx_galaxy_ng_ui_enabled: true
awx_galaxy_ng_ui_image: quay.io/pulp/galaxy-web
awx_galaxy_ng_ui_image_tag: "4.9.2"
awx_galaxy_ng_ui_port: 8080
awx_galaxy_ng_admin_user: admin
awx_galaxy_ng_admin_password: "{{ lookup('env', 'GALAXY_NG_ADMIN_PASSWORD') | default(awx_admin_password, true) }}"
awx_galaxy_ng_postgres_password: "{{ lookup('env', 'GALAXY_NG_POSTGRES_PASSWORD') }}"
awx_galaxy_ng_secret_key: "{{ lookup('env', 'GALAXY_NG_SECRET_KEY') }}"
awx_galaxy_ng_auth_token: "{{ lookup('env', 'GALAXY_NG_AUTH_TOKEN') | default('', true) }}"
awx_galaxy_ng_server_url: ""
awx_galaxy_ng_verify_ssl: false
awx_galaxy_ng_public_port: 5001

# k3s/k8s Galaxy NG path.
awx_galaxy_ng_namespace: galaxy-ng
awx_galaxy_ng_name: awx-galaxy-ng
awx_galaxy_ng_service_type: ClusterIP
awx_galaxy_ng_node_port: 30501
awx_galaxy_ng_postgres_access_mode: ReadWriteOnce
awx_galaxy_ng_pulp_access_mode: ReadWriteOnce
awx_galaxy_ng_postgres_storage_size: 20Gi
awx_galaxy_ng_pulp_storage_size: 50Gi
awx_galaxy_ng_ui_replicas: 1

# Project Quay / execution environment image registry integration.
# Galaxy NG stores collection content. Project Quay stores container images for
# AWX execution environments built from AWX Projects.
# For k3s/k8s, enabling this deploys Project Quay beside AWX and configures AWX
# to talk to the in-cluster Quay service. For server deployments, deploy Quay on
# hosts in [awx_quay], then set awx_quay_configure_awx_settings=true.
awx_quay_enabled: false
awx_quay_configure_awx_settings: "{{ awx_quay_enabled }}"
awx_quay_image: quay.io/projectquay/quay
awx_quay_image_tag: latest
awx_quay_admin_user: admin
awx_quay_admin_password: "{{ lookup('env', 'QUAY_ADMIN_PASSWORD') | default(awx_admin_password, true) }}"
awx_quay_admin_email: admin@example.com
awx_quay_initialize_admin: true
awx_quay_postgres_password: "{{ lookup('env', 'QUAY_POSTGRES_PASSWORD') }}"
awx_quay_database_secret_key: "{{ lookup('env', 'QUAY_DATABASE_SECRET_KEY') }}"
awx_quay_secret_key: "{{ lookup('env', 'QUAY_SECRET_KEY') }}"
awx_quay_registry_url: ""
awx_quay_namespace: admin
awx_quay_api_token: "{{ lookup('env', 'QUAY_API_TOKEN') | default('', true) }}"
awx_quay_push_username: "{{ lookup('env', 'QUAY_PUSH_USERNAME') | default('', true) }}"
awx_quay_push_token: "{{ lookup('env', 'QUAY_PUSH_TOKEN') | default('', true) }}"
awx_quay_verify_ssl: false
awx_quay_public_port: 8081

# k3s/k8s Project Quay path.
awx_quay_k8s_namespace: quay
awx_quay_name: awx-quay
awx_quay_service_type: ClusterIP
awx_quay_node_port: 30881
awx_quay_postgres_access_mode: ReadWriteOnce
awx_quay_storage_access_mode: ReadWriteOnce
awx_quay_postgres_storage_size: 20Gi
awx_quay_registry_storage_size: 50Gi
awx_quay_backup_name: "quay-{{ ansible_date_time.iso8601_basic_short }}"
awx_quay_backup_collect_storage: true
awx_quay_backup_owner: root
awx_quay_backup_group: root
awx_quay_k8s_backup_name: "quay-k8s-{{ ansible_date_time.iso8601_basic_short }}"
awx_quay_k8s_backup_collect_storage: true
awx_quay_k8s_backup_owner: root
awx_quay_k8s_backup_group: root
awx_quay_restore_confirm: false
awx_quay_restore_path: ""
awx_quay_k8s_restore_confirm: false
awx_quay_k8s_restore_path: ""
awx_quay_failback_image_tag: ""
awx_quay_failback_restore_path: ""
awx_quay_upgrade_skip_backup: false
awx_quay_upgrade_skip_pull: false

# Policy as Code integration.
# OPA can run beside AWX in k3s/k8s or on a dedicated VM/container host.
# Gatekeeper is Kubernetes-only; enable it only for k3s/k8s clusters or when a
# server AWX deployment is managing a remote Kubernetes API.
awx_opa_enabled: false
awx_opa_configure_awx_settings: "{{ awx_opa_enabled }}"
awx_opa_host: ""
awx_opa_port: 8181
awx_opa_ssl: false
awx_opa_auth_type: None
awx_opa_request_timeout: 1.5
awx_opa_request_retries: 2

# Standalone OPA VM/container path.
awx_opa_container_image: docker.io/openpolicyagent/opa:latest
awx_opa_server_http_port: 8181
awx_opa_server_policy: ""

# k3s/k8s OPA path.
awx_opa_k8s_namespace: opa
awx_opa_name: awx-opa
awx_opa_k8s_service_type: ClusterIP
awx_opa_k8s_node_port: 30818

# Kubernetes Gatekeeper path.
awx_gatekeeper_enabled: false
awx_gatekeeper_configure_awx_settings: "{{ awx_gatekeeper_enabled }}"
awx_gatekeeper_version: v3.22.2
awx_gatekeeper_k8s_api_url: https://kubernetes.default.svc
awx_gatekeeper_k8s_context: in-cluster
awx_gatekeeper_k8s_use_service_account_token: true
awx_gatekeeper_k8s_verify_ssl: true
